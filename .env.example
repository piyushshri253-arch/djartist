# DJ G SPARK - Environment Variables Configuration Template
# Configure these in your production host (e.g. Vercel Project Settings -> Environment Variables)
# DO NOT commit real secrets or production passwords into git.

# Database Configuration (MongoDB Atlas Cloud)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dj_g_spark?retryWrites=true&w=majority

# Admin Panel Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_random_admin_password_here
SESSION_SECRET=your_32_byte_random_session_secret_hex

# WhatsApp Webhook (Pabbly Connect for Instant Lead Notifications)
WHATSAPP_WEBHOOK_URL=https://connect.pabbly.com/webhook-listener/webhook/your_webhook_endpoint_here

# Instagram Graph API Integration (Optional for OAuth login)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
INSTAGRAM_STATE_SECRET=your_random_state_secret_here
